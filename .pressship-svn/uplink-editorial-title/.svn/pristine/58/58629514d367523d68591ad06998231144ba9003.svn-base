.uplink-editorial-title__trigger {
	inline-size: 100%;
	min-block-size: 68px;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	justify-content: center;
	gap: 8px;
	padding: 12px;
	border: 1px solid #949494;
	border-radius: 4px;
	background: #fff;
	color: #1e1e1e;
	text-align: left;
	cursor: text;
}

.uplink-editorial-title__trigger:hover {
	border-color: #757575;
}

.uplink-editorial-title__trigger:focus-visible,
.uplink-editorial-title__trigger[aria-expanded="true"] {
	border-color: var(--wp-admin-theme-color, #3858e9);
	box-shadow: 0 0 0 1px var(--wp-admin-theme-color, #3858e9);
	outline: 2px solid transparent;
}

.uplink-editorial-title__trigger-text {
	font-size: 16px;
	font-weight: 600;
	line-height: 1.35;
}

.uplink-editorial-title__trigger-text strong { font-weight: 700; }
.uplink-editorial-title__trigger-text em { font-style: italic; }
.uplink-editorial-title__trigger-text mark {
	padding-inline: 0.1em;
	background: #fff2a8;
	color: inherit;
}
.uplink-editorial-title__trigger-text s { text-decoration: line-through; }
.uplink-editorial-title__trigger-text sub,
.uplink-editorial-title__trigger-text sup {
	font-size: 0.72em;
	line-height: 0;
}

.uplink-editorial-title__trigger.is-fallback .uplink-editorial-title__trigger-text {
	color: #757575;
	font-weight: 400;
}

.uplink-editorial-title__trigger-status {
	font-size: 11px;
	line-height: 1;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	color: #757575;
}

.uplink-editorial-title__action {
	margin-block-start: 6px;
	font-size: 12px;
}

/* Contextual editor surface: compact, quiet, and intentionally close to Gutenberg. */
.uplink-editorial-title__popover .components-popover__content {
	inline-size: min(520px, calc(100vw - 32px));
	max-inline-size: 520px;
	border: 1px solid #dcdcde;
	border-radius: 12px;
	background: #fff;
	box-shadow:
		0 1px 2px rgba(0, 0, 0, 0.06),
		0 10px 28px rgba(0, 0, 0, 0.14);
	overflow: hidden;
}

.uplink-editorial-title__popover-inner {
	padding: 10px;
	background: #fff;
}

.uplink-editorial-title__toolbar {
	min-block-size: 52px;
	display: flex;
	align-items: center;
	padding: 5px;
	border: 0;
	border-radius: 9px;
	background: #f6f7f7;
}

.uplink-editorial-title__toolbar .components-toolbar-group {
	inline-size: 100%;
	display: grid;
	grid-template-columns: repeat(6, minmax(44px, 1fr));
	align-items: center;
	gap: 4px;
	border: 0;
}

.uplink-editorial-title__toolbar .components-toolbar-button {
	inline-size: 100%;
	min-inline-size: 44px;
	block-size: 44px;
	justify-content: center;
	padding: 0;
	border: 0;
	border-radius: 7px;
	background: transparent;
	color: #2f2f2f;
	transition: background-color 80ms linear, color 80ms linear, box-shadow 80ms linear;
}

.uplink-editorial-title__toolbar .components-toolbar-button:not(:disabled):hover {
	background: #fff;
	color: #1e1e1e;
	box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
}

.uplink-editorial-title__toolbar .components-toolbar-button:not(:disabled):focus-visible {
	box-shadow: 0 0 0 2px var(--wp-admin-theme-color, #3858e9);
	outline: 2px solid transparent;
}

.uplink-editorial-title__toolbar .components-toolbar-button.is-pressed,
.uplink-editorial-title__toolbar .components-toolbar-button[aria-pressed="true"] {
	background: #1e1e1e;
	color: #fff;
	box-shadow: none;
}

.uplink-editorial-title__toolbar .components-toolbar-button.is-pressed:not(:disabled):hover,
.uplink-editorial-title__toolbar .components-toolbar-button[aria-pressed="true"]:not(:disabled):hover {
	background: #1e1e1e;
	color: #fff;
	box-shadow: none;
}

.uplink-editorial-title__toolbar .components-toolbar-button.is-pressed:not(:disabled):focus-visible,
.uplink-editorial-title__toolbar .components-toolbar-button[aria-pressed="true"]:not(:disabled):focus-visible {
	background: #1e1e1e;
	color: #fff;
	box-shadow: 0 0 0 2px var(--wp-admin-theme-color, #3858e9);
}

.uplink-editorial-title__toolbar .components-toolbar-button.is-pressed span[aria-hidden="true"],
.uplink-editorial-title__toolbar .components-toolbar-button[aria-pressed="true"] span[aria-hidden="true"] {
	color: #fff;
}

.uplink-editorial-title__toolbar .components-toolbar-button:disabled {
	opacity: 0.34;
}

.uplink-editorial-title__format-button span[aria-hidden="true"] {
	position: relative;
	min-inline-size: 24px;
	display: inline-grid;
	place-items: center;
	font-size: 20px;
	font-weight: 600;
	line-height: 1;
	letter-spacing: -0.02em;
}

.uplink-editorial-title__format-button.is-bold span {
	font-weight: 800;
}

.uplink-editorial-title__format-button.is-italic span {
	font-family: Georgia, "Times New Roman", serif;
	font-size: 22px;
	font-style: italic;
	font-weight: 700;
}

/* A familiar highlighter cue instead of a plugin-specific letter badge. */
.uplink-editorial-title__format-button.is-mark span {
	padding-block-end: 4px;
}

.uplink-editorial-title__format-button.is-mark span::after {
	content: "";
	position: absolute;
	inset-inline: 1px;
	inset-block-end: 0;
	block-size: 5px;
	border-radius: 2px;
	background: #f7d84a;
}

.uplink-editorial-title__toolbar .components-toolbar-button.is-mark.is-pressed span,
.uplink-editorial-title__toolbar .components-toolbar-button.is-mark[aria-pressed="true"] span {
	color: #fff;
}

.uplink-editorial-title__format-button.is-strike span {
	text-decoration-thickness: 2px;
	text-decoration-line: line-through;
}

.uplink-editorial-title__format-button.is-script span {
	font-size: 18px;
	font-weight: 650;
	letter-spacing: -0.04em;
}

.uplink-editorial-title__editor {
	margin-block-start: 8px;
	border: 1px solid #e0e0e0;
	border-radius: 9px;
	background: #fff;
	box-shadow: 0 1px 1px rgba(0, 0, 0, 0.02);
	transition: border-color 80ms linear, box-shadow 80ms linear;
}

.uplink-editorial-title__editor:hover {
	border-color: #c3c4c7;
}

.uplink-editorial-title__editor:focus-within {
	border-color: var(--wp-admin-theme-color, #3858e9);
	box-shadow: 0 0 0 1px var(--wp-admin-theme-color, #3858e9);
}

.uplink-editorial-title__rich-text {
	min-block-size: 104px;
	padding: 22px 22px 24px;
	font-size: 26px;
	font-weight: 600;
	line-height: 1.25;
	letter-spacing: -0.015em;
	outline: 0;
}

.uplink-editorial-title__rich-text[data-rich-text-placeholder]::after {
	opacity: 0.42;
	font-weight: 400;
}

.uplink-editorial-title__rich-text mark {
	padding-inline: 0.08em;
	background: #fff2a8;
	color: inherit;
}

.uplink-editorial-title-panel .components-base-control {
	margin-block-end: 16px;
}

.uplink-editorial-title__canonical-note {
	margin: -4px 0 0;
	color: #646970;
	font-size: 12px;
	line-height: 1.45;
}

@media (max-width: 782px) {
	.uplink-editorial-title__popover .components-popover__content {
		inline-size: 100%;
		max-inline-size: none;
		border-radius: 0;
	}

	.uplink-editorial-title__toolbar .components-toolbar-group {
		grid-template-columns: repeat(3, 1fr);
	}
}

/* Highlight color control. */
.uplink-editorial-title__format-button.is-mark span::after {
	background: var(--uet-highlight-indicator, #f7d84a);
}

.uplink-editorial-title__color-popover .components-popover__content {
	inline-size: min(400px, calc(100vw - 32px));
	padding: 0;
	border: 1px solid #dcdcde;
	border-radius: 10px;
	background: #fff;
	box-shadow:
		0 1px 2px rgba(0, 0, 0, 0.06),
		0 8px 24px rgba(0, 0, 0, 0.14);
	overflow: hidden;
}

.uplink-editorial-title__color-panel {
	padding: 0;
}

.uplink-editorial-title__color-tabs .components-tab-panel__tabs {
	display: flex;
	gap: 0;
	border-block-end: 1px solid #dcdcde;
}

.uplink-editorial-title__color-tabs .components-tab-panel__tabs-item {
	block-size: 48px;
	padding-inline: 20px;
	border-block-end: 2px solid transparent;
	font-size: 14px;
}

.uplink-editorial-title__color-tabs .components-tab-panel__tabs-item.is-active {
	border-block-end-color: var(--wp-admin-theme-color, #3858e9);
}

.uplink-editorial-title__color-tabs .components-tab-panel__tab-content {
	padding: 16px;
}

.uplink-editorial-title__advanced-color {
	margin-block-start: 16px;
	padding-block-start: 16px;
	border-block-start: 1px solid #e0e0e0;
}

.uplink-editorial-title__advanced-color .components-base-control {
	margin-block-end: 12px;
}

.uplink-editorial-title__color-error {
	margin: 0 0 12px;
	color: #b32d2e;
	font-size: 12px;
	line-height: 1.4;
}
